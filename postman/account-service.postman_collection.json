    {
      "name": "Debit Cards",
      "item": [
        {
          "name": "Create Debit Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tarjeta creada', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "  pm.collectionVariables.set('debit_card_id', response.id);",
                  "}",
                  "if (response.cardNumber) {",
                  "  pm.collectionVariables.set('card_number', response.cardNumber);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"mainAccountId\": \"{{account_id}}\",\n  \"cardNumber\": \"{{card_number}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/account-service/api/v1/accounts/debit-card",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "account-service",
                "api",
                "v1",
                "accounts",
                "debit-card"
              ]
            }
          },
          "response": []
